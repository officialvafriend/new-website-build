# WordPress.com GitHub Deployments 제외 목록 (.gitignore 와 같은 문법)
# 여기 있는 것들은 사이트로 복사되지 않습니다.

# Claude Code 스킬 — 개발 도구일 뿐 사이트 코드가 아닙니다 (약 11MB)
.claude/

# 디자인 시안과 문서 — 참고용. 사이트에서 로드되지 않습니다.
design/

# 저장소 메타
.git/
.gitignore
.deployignore
README.md
CLAUDE.md

# 개발 부산물
node_modules/
__pycache__/
*.pyc
.DS_Store

# 참고용 원본 소스 — 사이트에 이미 별도 플러그인으로 설치돼 있습니다.
# 배포하면 안 됩니다.
reference/
